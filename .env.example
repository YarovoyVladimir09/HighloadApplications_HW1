# Application ports on the host. Both containers listen on port 8080.
APP1_PORT=18081
APP2_PORT=18082

# Demonstration settings used by both replicas.
ENABLE_DEMO_FAULTS=1
DEMO_DELAY_MS=5

# Prometheus port on the host.
PROMETHEUS_PORT=9090

# Reserved for the Grafana service to be added later.
# No real credentials belong in this example. Grafana is not started yet.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Reserved for the load generator to be added later.
LOAD_RPS=30
LOAD_RAMP_SECONDS=120
LOAD_ERROR_PERCENT=4
